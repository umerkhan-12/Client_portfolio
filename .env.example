# Copy to .env.local for local development, and add the same variables in Vercel → Project → Settings → Environment Variables.

# Required for the contact form. Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form messages are delivered (defaults to uneebahm@gmail.com).
CONTACT_TO_EMAIL=uneebahm@gmail.com

# Sender address. Must be on a domain you've verified in Resend.
# Until a domain is verified, Resend's test sender (onboarding@resend.dev) only
# delivers to the email address that owns the Resend account.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# Public URL of the deployed site (used for social-share previews and canonical links).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
